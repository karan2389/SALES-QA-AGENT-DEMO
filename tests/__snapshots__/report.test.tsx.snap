exports[`MRV1 report sections (flagship flagged call) > section 2 Overall Performance matches snapshot 1`] = `"<section id="s2" data-section="2" class="scroll-mt-28" aria-labelledby="s2-h"><div class="rounded-card border border-line bg-surface shadow-card"><div class="flex items-start gap-3 px-4 pb-3 pt-4"><span class="tabular flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-brand-soft text-xs font-bold text-brand">2</span><div class="min-w-0"><h2 id="s2-h" class="text-[15px] font-semibold text-ink">Overall Performance</h2><p class="mt-0.5 text-xs text-ink-muted">Two separate scores. They are never combined into one number.</p></div></div><div class="px-4 pb-4"><div class="grid gap-3 md:grid-cols-3"><div class="rounded-lg border border-line p-3.5" style="border-top-color:#1d4ed8;border-top-width:3px"><p class="flex items-center gap-1.5 text-xs font-medium text-ink-muted">Sales-stage score<span class="inline-flex"><span tabindex="0" class="inline-flex cursor-help text-ink-muted hover:text-ink" aria-label="More information"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span></span></p><p class="mt-1.5 text-[28px] leading-none"><span class="tabular font-semibold text-ink text-[28px]">37.3%</span></p><p class="mt-2 flex flex-wrap items-center gap-2 text-xs text-ink-muted"><span class="tabular">scored 70 · N/A 0 · NE 0</span></p></div><div class="rounded-lg border border-line p-3.5" style="border-top-color:#0f8b8d;border-top-width:3px"><p class="flex items-center gap-1.5 text-xs font-medium text-ink-muted">Sales Psychology &amp; Conduct score<span class="inline-flex"><span tabindex="0" class="inline-flex cursor-help text-ink-muted hover:text-ink" aria-label="More information"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span></span></p><p class="mt-1.5 text-[28px] leading-none"><span class="tabular font-semibold text-ink text-[28px]">43.9%</span></p><p class="mt-2 flex flex-wrap items-center gap-2 text-xs text-ink-muted"><span class="tabular">scored 22 · N/A 0 · NE 0</span></p></div><div class="rounded-lg border border-line p-3.5" style="border-top-color:#c83232;border-top-width:3px"><p class="flex items-center gap-1.5 text-xs font-medium text-ink-muted">Critical flags<span class="inline-flex"><span tabindex="0" class="inline-flex cursor-help text-ink-muted hover:text-ink" aria-label="More information"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></span></span></p><p class="tabular mt-1.5 flex items-center gap-2 text-[28px] font-semibold leading-none"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-octagon-exclamation-point lucide-alert-octagon lucide-octagon-alert h-6 w-6 text-bad" aria-hidden="true"><path d="M12 16h.01"></path><path d="M12 8v4"></path><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"></path></svg>1</p><p class="mt-2 text-xs text-ink-muted">0 pending a human decision</p></div></div><div class="mt-3 rounded-lg bg-subtle px-3 py-2.5 text-[13px] text-ink-soft"><p class="font-medium text-ink">Why final</p><p class="mt-0.5">No criterion was Not Evaluable, so both scores are final (they still require human review).</p></div><p class="mt-2 text-2xs text-ink-muted">Category % = sum of criterion scores ÷ (3 × number of numeric criteria) × 100.</p></div></div></section><div class="pointer-events-none fixed bottom-4 right-4 z-[110] flex w-[min(360px,calc(100vw-2rem))] flex-col gap-2" aria-live="polite"></div>"`;

exports[`MRV1 report sections (flagship flagged call) > section 3 Executive Summary matches snapshot 1`] = `"<section id="s3" data-section="3" class="scroll-mt-28" aria-labelledby="s3-h"><div class="rounded-card border border-line bg-surface shadow-card"><div class="flex items-start gap-3 px-4 pb-3 pt-4"><span class="tabular flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-brand-soft text-xs font-bold text-brand">3</span><div class="min-w-0"><h2 id="s3-h" class="text-[15px] font-semibold text-ink">Executive Summary</h2></div></div><div class="px-4 pb-4"><p class="text-[13px] leading-relaxed text-ink">This new webinar prospect call lasted 12 minutes in English. The sales-stage score is 37.3% and the separate Sales Psychology &amp; Conduct score is 43.9%. The strongest stage was Customer Persona and the weakest was Objection Handling. The prospect raised a lack of time objection, which was poorly. 1 critical flag was raised and needs a human decision.</p></div></div></section><div class="pointer-events-none fixed bottom-4 right-4 z-[110] flex w-[min(360px,calc(100vw-2rem))] flex-col gap-2" aria-live="polite"></div>"`;

exports[`MRV1 report sections (flagship flagged call) > section 4 Prospect Profile matches snapshot 1`] = `"<section id="s4" data-section="4" class="scroll-mt-28" aria-labelledby="s4-h"><div class="rounded-card border border-line bg-surface shadow-card"><div class="flex items-start gap-3 px-4 pb-3 pt-4"><span class="tabular flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-brand-soft text-xs font-bold text-brand">4</span><div class="min-w-0"><h2 id="s4-h" class="text-[15px] font-semibold text-ink">Prospect Profile</h2><p class="mt-0.5 text-xs text-ink-muted">What the call established about the prospect, each with its supporting transcript segment.</p></div></div><div class="px-4 pb-4"><dl class="divide-y divide-line"><div class="grid gap-1 py-2.5 sm:grid-cols-[170px_1fr_auto] sm:gap-4"><dt class="text-xs font-medium text-ink-muted">Occupation</dt><dd class="text-[13px] text-ink">I run a small coaching practice, mostly for college students.</dd><dd><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Segment 6</button></dd></div><div class="grid gap-1 py-2.5 sm:grid-cols-[170px_1fr_auto] sm:gap-4"><dt class="text-xs font-medium text-ink-muted">Business &amp; offer</dt><dd class="text-[13px] text-ink">Mostly online classes. I&#x27;ll use Instagram and WhatsApp groups.</dd><dd><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Segment 8</button></dd></div><div class="grid gap-1 py-2.5 sm:grid-cols-[170px_1fr_auto] sm:gap-4"><dt class="text-xs font-medium text-ink-muted">Marketing channels</dt><dd class="text-[13px] text-ink">Mostly online classes. I&#x27;ll use Instagram and WhatsApp groups.</dd><dd><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Segment 8</button></dd></div><div class="grid gap-1 py-2.5 sm:grid-cols-[170px_1fr_auto] sm:gap-4"><dt class="text-xs font-medium text-ink-muted">Goals</dt><dd class="text-[13px] text-ink">About one lakh a month by April.</dd><dd><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Segment 10</button></dd></div><div class="grid gap-1 py-2.5 sm:grid-cols-[170px_1fr_auto] sm:gap-4"><dt class="text-xs font-medium text-ink-muted">Challenges</dt><dd class="text-[13px] text-ink">Mostly I don&#x27;t know what to build first, and ads confuse me.</dd><dd><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Segment 17</button></dd></div></dl></div></div></section><div class="pointer-events-none fixed bottom-4 right-4 z-[110] flex w-[min(360px,calc(100vw-2rem))] flex-col gap-2" aria-live="polite"></div>"`;

