exports[`MRV1 report sections (flagship flagged call) > section 11 Critical Flags matches snapshot 1`] = `"<section id="s11" data-section="11" class="scroll-mt-28" aria-labelledby="s11-h"><div class="rounded-card border border-line bg-surface shadow-card"><div class="flex items-start gap-3 px-4 pb-3 pt-4"><span class="tabular flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-brand-soft text-xs font-bold text-brand">11</span><div class="min-w-0"><h2 id="s11-h" class="text-[15px] font-semibold text-ink">Critical Flags</h2><p class="mt-0.5 text-xs text-ink-muted">Flags are independent of scores and always need a human decision. Decisions are saved in this browser only.</p></div></div><div class="px-4 pb-4"><ul class="space-y-3"><li class="rounded-lg border border-bad/30 bg-bad-soft/30 p-3"><div class="flex flex-wrap items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-octagon-exclamation-point lucide-alert-octagon lucide-octagon-alert h-4 w-4 text-bad" aria-hidden="true"><path d="M12 16h.01"></path><path d="M12 8v4"></path><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"></path></svg><span class="text-[13px] font-semibold text-ink">False earnings promise</span><code class="text-2xs text-ink-muted">false_earnings_promise</code><span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2 py-0.5 text-xs font-medium bg-bad-soft text-bad border-bad/20 capitalize"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-octagon-exclamation-point lucide-alert-octagon lucide-octagon-alert h-3 w-3" aria-hidden="true"><path d="M12 16h.01"></path><path d="M12 8v4"></path><path d="M15.312 2a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586l-4.688-4.688A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2z"></path></svg>critical</span><span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2 py-0.5 text-xs font-medium bg-subtle text-ink-soft border-line">Interpretation: confirmed</span><span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2 py-0.5 text-xs font-medium bg-good-soft text-good border-good/20">Verified in transcript</span><span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2 py-0.5 text-xs font-medium bg-bad-soft text-bad border-bad/20">Human decision: confirmed (Kavita Joshi)</span></div><div class="mt-2.5"><figure class="rounded-md border border-line bg-subtle/60 p-2.5"><div class="flex flex-wrap items-center gap-2 text-xs"><span class="inline-flex items-center gap-1 whitespace-nowrap rounded px-1.5 py-0.5 text-2xs font-semibold bg-brand-soft text-brand">Salesperson</span><span class="tabular text-ink-muted">[08:41–08:59] · segment 26</span></div><blockquote class="mt-1.5 text-[13px] italic leading-relaxed text-ink-soft">“If you follow the plan you will definitely earn two lakh within two months — everyone does.”</blockquote><figcaption class="mt-1.5"><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Jump to transcript</button></figcaption></figure></div><p class="mt-2 text-[13px] text-ink"><span class="font-medium">Explanation: </span>Promises or implies guaranteed income or specific earnings. The quoted statement appears to match this pattern. <span class="text-ink-muted">Timestamp [08:41–08:59].</span></p><p class="mt-1.5 text-[13px] text-bad">Score cap: C15-03 capped at 1 because of flag false_earnings_promise.</p><div class="mt-3 flex flex-wrap gap-2"><button type="button" class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 bg-surface text-bad border border-bad/30 hover:bg-bad-soft h-8 px-3 text-[13px] gap-1.5" disabled="">Confirm</button><button type="button" class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 bg-surface text-ink-soft border border-line hover:bg-subtle hover:text-ink shadow-card h-8 px-3 text-[13px] gap-1.5">Dismiss</button><button type="button" class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 text-ink-soft hover:bg-subtle hover:text-ink h-8 px-3 text-[13px] gap-1.5">Needs audio check</button></div></li></ul></div></div></section><div class="pointer-events-none fixed bottom-4 right-4 z-[110] flex w-[min(360px,calc(100vw-2rem))] flex-col gap-2" aria-live="polite"></div>"`;

exports[`MRV1 report sections (flagship flagged call) > section 12 Personal Coaching Plan matches snapshot 1`] = `"<section id="s12" data-section="12" class="scroll-mt-28" aria-labelledby="s12-h"><div class="rounded-card border border-line bg-surface shadow-card"><div class="flex items-start gap-3 px-4 pb-3 pt-4"><span class="tabular flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-brand-soft text-xs font-bold text-brand">12</span><div class="min-w-0"><h2 id="s12-h" class="text-[15px] font-semibold text-ink">Personal Coaching Plan</h2><p class="mt-0.5 text-xs text-ink-muted">Up to 3 priorities.</p></div></div><div class="px-4 pb-4"><ol class="space-y-3"><li class="rounded-lg border border-line p-3"><p class="flex items-center gap-2 text-[13px] font-semibold"><span class="tabular flex h-5 w-5 items-center justify-center rounded-full bg-brand-soft text-xs text-brand">1</span>Objection Handling</p><dl class="mt-2 space-y-1.5 text-[13px]"><div><dt class="inline font-medium text-ink-muted">Observed issue: </dt><dd class="inline">Objection Handling is scoring 20% — weakest point: explores the root cause.</dd></div><div><dt class="inline font-medium text-ink-muted">Recommended action: </dt><dd class="inline">Practise explores the root cause in a role-play, then review the next call together.</dd></div></dl><div class="mt-2 rounded-md bg-brand-soft/60 p-2.5 text-[13px]"><p class="mb-1 flex items-center gap-1.5 text-xs font-semibold text-brand"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb h-3.5 w-3.5" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>Better-behaviour example</p><p class="italic text-ink">“I understand, and thanks for telling me. Can you share a bit more about what&#x27;s behind that concern? Then I can suggest a relevant option.”</p></div><div class="mt-2"><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Segment 31</button></div></li><li class="rounded-lg border border-line p-3"><p class="flex items-center gap-2 text-[13px] font-semibold"><span class="tabular flex h-5 w-5 items-center justify-center rounded-full bg-brand-soft text-xs text-brand">2</span>YES Mode</p><dl class="mt-2 space-y-1.5 text-[13px]"><div><dt class="inline font-medium text-ink-muted">Observed issue: </dt><dd class="inline">YES Mode is scoring 22% — weakest point: confirms readiness to proceed.</dd></div><div><dt class="inline font-medium text-ink-muted">Recommended action: </dt><dd class="inline">Practise confirms readiness to proceed in a role-play, then review the next call together.</dd></div></dl><div class="mt-2 rounded-md bg-brand-soft/60 p-2.5 text-[13px]"><p class="mb-1 flex items-center gap-1.5 text-xs font-semibold text-brand"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb h-3.5 w-3.5" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>Better-behaviour example</p><p class="italic text-ink">“So you want a guided start, templates, and someone to review your first funnel — does that sound right?”</p></div><div class="mt-2"><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Segment 27</button></div></li><li class="rounded-lg border border-line p-3"><p class="flex items-center gap-2 text-[13px] font-semibold"><span class="tabular flex h-5 w-5 items-center justify-center rounded-full bg-brand-soft text-xs text-brand">3</span>Testimonials</p><dl class="mt-2 space-y-1.5 text-[13px]"><div><dt class="inline font-medium text-ink-muted">Observed issue: </dt><dd class="inline">Testimonials is scoring 22% — weakest point: uses genuine, verifiable proof.</dd></div><div><dt class="inline font-medium text-ink-muted">Recommended action: </dt><dd class="inline">Practise uses genuine, verifiable proof in a role-play, then review the next call together.</dd></div></dl><div class="mt-2 rounded-md bg-brand-soft/60 p-2.5 text-[13px]"><p class="mb-1 flex items-center gap-1.5 text-xs font-semibold text-brand"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb h-3.5 w-3.5" aria-hidden="true"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>Better-behaviour example</p><p class="italic text-ink">“A coach like you built her first funnel in three weeks — I can share her walkthrough.”</p></div><div class="mt-2"><button class="inline-flex items-center gap-1 text-xs font-medium text-brand hover:underline"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-arrow-right lucide-arrow-right-circle h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path d="M8 12h8"></path></svg>Segment 24</button></div></li></ol></div></div></section><div class="pointer-events-none fixed bottom-4 right-4 z-[110] flex w-[min(360px,calc(100vw-2rem))] flex-col gap-2" aria-live="polite"></div>"`;

exports[`MRV1 report sections (flagship flagged call) > section 13 Final Coaching Note matches snapshot 1`] = `"<section id="s13" data-section="13" class="scroll-mt-28" aria-labelledby="s13-h"><div class="rounded-card border border-line bg-surface shadow-card"><div class="flex items-start gap-3 px-4 pb-3 pt-4"><span class="tabular flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-brand-soft text-xs font-bold text-brand">13</span><div class="min-w-0"><h2 id="s13-h" class="text-[15px] font-semibold text-ink">Final Coaching Note</h2></div></div><div class="px-4 pb-4"><p class="flex gap-2 text-[13px] leading-relaxed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle-exclamation-point lucide-message-circle-warning lucide-message-circle-alert mt-0.5 h-4 w-4 shrink-0 text-brand" aria-hidden="true"><path d="M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719"></path><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>Focus the next coaching session on Objection Handling, YES Mode, Testimonials. Review the flagged statements together before the next call.</p></div></div></section><div class="pointer-events-none fixed bottom-4 right-4 z-[110] flex w-[min(360px,calc(100vw-2rem))] flex-col gap-2" aria-live="polite"></div>"`;

exports[`MRV1 report sections (flagship flagged call) > section 14 Human Review matches snapshot 1`] = `"<section id="s14" data-section="14" class="scroll-mt-28" aria-labelledby="s14-h"><div class="rounded-card border border-line bg-surface shadow-card"><div class="flex items-start gap-3 px-4 pb-3 pt-4"><span class="tabular flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-brand-soft text-xs font-bold text-brand">14</span><div class="min-w-0"><h2 id="s14-h" class="text-[15px] font-semibold text-ink">Human Review</h2><p class="mt-0.5 text-xs text-ink-muted">Every evaluation starts as “Pending human review”. Nothing is approved by the AI.</p></div></div><div class="px-4 pb-4"><div class="flex flex-wrap items-center gap-2"><span class="text-xs text-ink-muted">Status</span><span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2 py-0.5 text-xs font-medium bg-subtle text-ink-soft border-line">Pending human review</span></div><div class="mt-4 grid gap-4 md:grid-cols-2"><div><h3 class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-ink-muted">Verify</h3><ul class="space-y-1.5 text-[13px]"><li class="flex gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-check mt-0.5 h-3.5 w-3.5 shrink-0 text-brand" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path></svg>Verify: Verify objection responses: the Approved Objection Doc is not yet available.</li></ul></div><div><h3 class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-ink-muted">Validation</h3><p class="text-[13px] text-ink-muted">No validation warnings.</p><p class="tabular mt-2 text-xs text-ink-muted">Criteria total: 92 (70 sales-stage + 22 psychology)</p></div></div><div class="mt-4 grid gap-4 md:grid-cols-2"><div><label for="rev-notes" class="text-xs font-medium text-ink-muted">Reviewer notes</label><textarea class="w-full rounded-md border border-line bg-surface px-3 text-sm text-ink placeholder:text-ink-muted/70 transition-colors hover:border-ink-muted/40 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20 disabled:opacity-50 h-auto min-h-[84px] py-2 leading-snug mt-1" id="rev-notes" placeholder="Add context for the team…"></textarea><div class="mt-2 flex flex-wrap gap-2"><button type="button" class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 bg-surface text-ink-soft border border-line hover:bg-subtle hover:text-ink shadow-card h-8 px-3 text-[13px] gap-1.5" disabled="">Save note</button><button type="button" class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 bg-good text-white hover:bg-good/90 shadow-card h-8 px-3 text-[13px] gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 h-3.5 w-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg>Approve</button><button type="button" class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 bg-surface text-bad border border-bad/30 hover:bg-bad-soft h-8 px-3 text-[13px] gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-exclamation-point lucide-shield-alert h-3.5 w-3.5" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>Dispute</button></div></div><div><label for="corr-pick" class="text-xs font-medium text-ink-muted">Correct a criterion outcome</label><div class="relative mt-1"><select class="h-9 w-full rounded-md border border-line bg-surface px-3 text-sm text-ink placeholder:text-ink-muted/70 transition-colors hover:border-ink-muted/40 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20 disabled:opacity-50 appearance-none pr-8" id="corr-pick" aria-label="Criterion to correct"><option value="" selected="">Choose a criterion…</option><option value="C01-01">C01-01 — Greets and states name and company</option><option value="C01-02">C01-02 — Sets purpose and agenda for the call</option><option value="C01-03">C01-03 — Builds rapport and asks permission to proceed</option><option value="C02-01">C02-01 — Asks why the prospect attended the webinar</option><option value="C02-02">C02-02 — Asks what prompted the enquiry now</option><option value="C02-03">C02-03 — Clarifies what the prospect hopes to achieve</option><option value="C02-04">C02-04 — Asks about the prospect&#x27;s current situation</option><option value="C02-05">C02-05 — Confirms understanding by paraphrasing</option><option value="C02-06">C02-06 — Asks about earlier attempts at online business</option><option value="C03-01">C03-01 — Captures occupation and background</option><option value="C03-02">C03-02 — Identifies who the prospect wants to sell to</option><option value="C03-03">C03-03 — Explores skills and experience</option><option value="C04-01">C04-01 — Asks what business the prospect plans to start</option><option value="C04-02">C04-02 — Asks which products or services they will sell</option><option value="C04-03">C04-03 — Explores planned marketing channels</option><option value="C04-04">C04-04 — Asks about the launch timeline</option><option value="C05-01">C05-01 — Asks for the target income</option><option value="C05-02">C05-02 — Asks by when they want to reach it</option><option value="C05-03">C05-03 — Quantifies the gap versus current income</option><option value="C06-01">C06-01 — Explores the personal reason behind the goal</option><option value="C06-02">C06-02 — Connects the goal to family or lifestyle</option><option value="C06-03">C06-03 — Reflects the emotion back to the prospect</option><option value="C07-01">C07-01 — Asks what makes this the right time</option><option value="C07-02">C07-02 — Explores the cost of waiting</option><option value="C07-03">C07-03 — Establishes genuine (not manufactured) urgency</option><option value="C08-01">C08-01 — Reviews the prospect&#x27;s plan with them</option><option value="C08-02">C08-02 — Identifies gaps in the plan</option><option value="C08-03">C08-03 — Checks that the plan is realistic</option><option value="C08-04">C08-04 — Summarises the plan back</option><option value="C09-01">C09-01 — Asks about current challenges</option><option value="C09-02">C09-02 — Probes the impact of each challenge</option><option value="C09-03">C09-03 — Prioritises the biggest challenge</option><option value="C10-01">C10-01 — Asks where the prospect lacks knowledge</option><option value="C10-02">C10-02 — Assesses comfort with tools and technology</option><option value="C10-03">C10-03 — Links gaps to the need for guidance</option><option value="C11-01">C11-01 — Maps features to the stated challenges</option><option value="C11-02">C11-02 — Describes how support works accurately</option><option value="C11-03">C11-03 — Explains outcomes without exaggeration</option><option value="C11-04">C11-04 — Checks the prospect&#x27;s understanding</option><option value="C12-01">C12-01 — Asks about previous courses or tools</option><option value="C12-02">C12-02 — Asks what worked and what did not</option><option value="C12-03">C12-03 — Differentiates accurately from past experiences</option><option value="C13-01">C13-01 — Highlights the cost of inaction using the prospect&#x27;s own words</option><option value="C13-02">C13-02 — Avoids exaggerating beyond what the prospect said</option><option value="C13-03">C13-03 — Checks the emotional response respectfully</option><option value="C14-01">C14-01 — Shares a relevant testimonial</option><option value="C14-02">C14-02 — Matches the story to the prospect&#x27;s profile</option><option value="C14-03">C14-03 — Uses genuine, verifiable proof</option><option value="C15-01">C15-01 — States the key differentiators</option><option value="C15-02">C15-02 — Compares fairly with alternatives</option><option value="C15-03">C15-03 — Makes claims supported by product facts</option><option value="C15-04">C15-04 — Explains community and support</option><option value="C15-05">C15-05 — Explains pricing and value</option><option value="C16-01">C16-01 — Secures small agreements along the way</option><option value="C16-02">C16-02 — Summarises the points agreed</option><option value="C16-03">C16-03 — Confirms readiness to proceed</option><option value="C17-01">C17-01 — Asks for the decision</option><option value="C17-02">C17-02 — Confirms budget and payment readiness</option><option value="C17-03">C17-03 — Offers a clear next step</option><option value="C17-04">C17-04 — Confirms date and time for follow-up</option><option value="C17-05">C17-05 — Explains the enrolment process clearly</option><option value="C18-01">C18-01 — Acknowledges the objection</option><option value="C18-02">C18-02 — Explores the root cause</option><option value="C18-03">C18-03 — Responds with relevant evidence</option><option value="C18-04">C18-04 — Checks whether the concern is resolved</option><option value="C18-05">C18-05 — Respects a clear refusal</option><option value="C19-01">C19-01 — Treats the objection as a buying signal</option><option value="C19-02">C19-02 — Reframes the objection constructively</option><option value="C19-03">C19-03 — Reconnects to the prospect&#x27;s goal</option><option value="C19-04">C19-04 — Re-closes after resolving the concern</option><option value="SP-01">SP-01 — Respectful tone throughout</option><option value="SP-02">SP-02 — Active listening</option><option value="SP-03">SP-03 — Lets the prospect finish speaking</option><option value="SP-04">SP-04 — Honest product claims</option><option value="SP-05">SP-05 — No guaranteed-earnings language</option><option value="SP-06">SP-06 — No manufactured urgency</option><option value="SP-07">SP-07 — No financial pressure</option><option value="SP-08">SP-08 — Respects a refusal</option><option value="SP-09">SP-09 — Describes support accurately</option><option value="SP-10">SP-10 — Uses genuine social proof</option><option value="SP-11">SP-11 — No coercive emotional pressure</option><option value="SP-12">SP-12 — Checks customer fit honestly</option><option value="SP-13">SP-13 — Professional language</option><option value="SP-14">SP-14 — Clear pace and articulation</option><option value="SP-15">SP-15 — Shows empathy</option><option value="SP-16">SP-16 — Confident without being arrogant</option><option value="SP-17">SP-17 — Transparent about pricing</option><option value="SP-18">SP-18 — Avoids unexplained jargon</option><option value="SP-19">SP-19 — Sets realistic expectations</option><option value="SP-20">SP-20 — Handles personal data with care</option><option value="SP-21">SP-21 — Handles hesitation and silence well</option><option value="SP-22">SP-22 — Ends the call professionally</option></select><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down pointer-events-none absolute right-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-muted" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></div><button type="button" class="inline-flex shrink-0 items-center whitespace-nowrap rounded-md font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 bg-surface text-ink-soft border border-line hover:bg-subtle hover:text-ink shadow-card h-8 px-3 text-[13px] gap-1.5 mt-2" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil h-3.5 w-3.5" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg>Correct outcome…</button></div></div><div class="mt-5 border-t border-line pt-3"><h3 class="mb-2 text-[13px] font-semibold">Review history <span class="font-normal text-ink-muted">(1)</span></h3><ol class="space-y-2.5"><li class="flex gap-2.5 text-[13px]"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check mt-0.5 h-4 w-4 shrink-0 text-ink-muted" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><div><p><span class="font-medium">Kavita Joshi</span> · Flag decision (confirmed)</p><p class="text-xs text-ink-muted">07 Oct 2026, 11:15 PM</p><p class="mt-0.5 text-ink-soft">Confirmed from the recording.</p></div></li></ol></div></div></div></section><div class="pointer-events-none fixed bottom-4 right-4 z-[110] flex w-[min(360px,calc(100vw-2rem))] flex-col gap-2" aria-live="polite"></div>"`;
